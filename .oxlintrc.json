{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "react", "jsx-a11y", "import"],
  "options": { "typeAware": true, "reportUnusedDisableDirectives": "warn" },
  "categories": { "correctness": "error", "suspicious": "warn" },
  "rules": {
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "ignoreRestSiblings": true }],
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "typescript/await-thenable": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/prefer-nullish-coalescing": "warn",
    "typescript/no-unsafe-type-assertion": "off",
    "react/react-in-jsx-scope": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "jsx-a11y/control-has-associated-label": ["warn", { "depth": 4 }],
    "import/no-unassigned-import": ["warn", { "allow": ["**/*.css"] }]
  },
  "overrides": [
    {
      "files": ["src/**/*.{ts,tsx}"],
      "rules": {
        "react-hooks/rules-of-hooks": "error",
        "react-hooks/exhaustive-deps": "warn",
        "react/only-export-components": ["warn", { "allowConstantExport": true }]
      }
    },
    {
      "files": ["src/**/*.test.{ts,tsx}"],
      "plugins": ["vitest"]
    }
  ],
  "ignorePatterns": ["dist", "coverage", "playwright-report", "test-results"]
}
